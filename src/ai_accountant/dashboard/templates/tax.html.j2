{% extends "base.html.j2" %}
{% block title %}{% if unified_tax_assistant %}Unified Tax Assistant — {{ tax_file.name }}{% else %}Tax Assistant — {{ address_short }}{% endif %} — AI Accountant{% endblock %}
{% block body %}
{% set has_tax_payment_plan = tax_payment_plan is defined and tax_payment_plan.available %}

<section class="wallet-header">
  <div>
    <p class="eyebrow">{% if unified_tax_assistant %}Unified Tax Assistant{% else %}Tax Assistant{% endif %}</p>
    {% if unified_tax_assistant %}
    <h1>{{ tax_file.name }}</h1>
    <p class="meta-line">{{ tax_file.tax_year }} • {{ tax_file.tax_country }} • {{ tax_file.entity_type }}</p>
    {% if has_tax_payment_plan %}<p><mark class="neutral">Review Mode</mark></p>{% endif %}
    {% else %}
    <h1><code title="{{ address }}">{{ address_short }}</code></h1>
    {% endif %}
    {% if meta %}
    <p class="meta-line">{{ meta.row_count }} transactions • Last updated: {{ meta.fetched_at[:16] | replace('T', ' ') }} UTC</p>
    {% endif %}
  </div>
  <div class="header-actions">
    {% if unified_tax_assistant %}
    <a href="{{ url_for('tax_file_detail_route', tax_file_id=tax_file.id) }}" class="button secondary">Back to tax file</a>
    {% else %}
    <a href="{{ url_for('wallet_page_route', address=address) }}" class="button secondary">Back to wallet</a>
    {% endif %}
  </div>
</section>

<div class="tax-disclaimer">
  This is not financial or tax advice. Always consult a qualified tax professional.
</div>

<section class="tax-settings">
  {% if demo_us_only|default(false) or has_tax_payment_plan %}
  <div class="tax-country-lock">
    <span class="muted">Tax country</span>
    <strong>United States</strong>
  </div>
  {% else %}
  {% if unified_tax_assistant %}
  <form method="get" action="{{ url_for('tax_file_tax_route', tax_file_id=tax_file.id) }}">
  {% else %}
  <form method="get" action="{{ url_for('tax_country_page_route', address=address) }}">
  {% endif %}
    <label>Tax country
      <select name="tax_country">
        {% for country in tax_country_options %}
        <option value="{{ country.code }}" {% if country.code == tax_country %}selected{% endif %}>{{ country.label }}</option>
        {% endfor %}
      </select>
    </label>
    <button type="submit">Apply</button>
  </form>
  {% endif %}
  <div>
    <strong>{{ tax_country_profile.label }} notes</strong>
    <p class="muted">{{ tax_country_profile.summary }}</p>
    <p class="muted">
      Sources:
      {% for source in tax_country_profile.sources %}
      <a href="{{ source.url }}" target="_blank" rel="noreferrer">{{ source.label }}</a>{% if not loop.last %}, {% endif %}
      {% endfor %}
    </p>
  </div>
</section>

{% if no_data %}
<section class="empty-cache">
  {% if unified_tax_assistant %}
  <p>No tax-relevant owned-account events found for this tax file yet. Link owned accounts with cached transactions first.</p>
  {% else %}
  <p>No tax-relevant events found for this wallet. Fetch transactions first, or this wallet has no parsed activity yet.</p>
  {% endif %}
</section>

{% else %}

{% if unified_tax_assistant and has_tax_payment_plan %}
<section class="kpi-grid tax-kpi-grid">
  {% for metric in tax_payment_plan.kpis %}
  <article class="kpi {{ metric.class }}">
    <span>{{ metric.label }}</span><strong>{{ metric.value }}</strong>
    <small>{{ metric.note }}</small>
  </article>
  {% endfor %}
</section>
{% else %}
<section class="kpi-grid tax-kpi-grid">
  <article class="kpi kpi-income">
    <span>Income</span><strong class="positive">{{ summary.total_income_sol }}</strong>
    <small>Incoming values that may require classification.</small>
  </article>
  <article class="kpi kpi-expense">
    {% if unified_tax_assistant %}
    <span>Outflows needing classification</span><strong>{{ summary.total_expense_sol }}</strong>
    <small>Outgoing values that still need transfer, disposal, or payment context.</small>
    {% else %}
    <span>Expense</span><strong>{{ summary.total_expense_sol }}</strong>
    <small>Outgoing SOL/assets treated as expense or outflow.</small>
    {% endif %}
  </article>
  <article class="kpi kpi-fee">
    <span>Fees paid</span><strong>{{ summary.total_fees_sol }}</strong>
    <small>Network fees paid by this wallet.</small>
  </article>
  <article class="kpi kpi-net">
    <span>Net change</span><strong class="{{ 'positive' if summary.net_positive else 'negative' }}">{{ summary.net_sol }}</strong>
    <small>Income minus expenses in SOL.</small>
  </article>
  <article class="kpi kpi-info">
    <span>Potentially taxable events</span><strong>{{ summary.taxable_count }}</strong>
    <small>Events likely relevant but not final tax conclusions.</small>
  </article>
  <article class="kpi kpi-review">
    <span>Review needed</span><strong>{{ summary.review_count }}</strong>
    <small>Transactions that need manual review or classification.</small>
  </article>
</section>
{% endif %}

{% set has_loss_playbook = unified_tax_assistant and tax_loss_harvesting %}
{% if has_tax_payment_plan %}
<section class="report-section tax-playbook">
  <div class="section-heading">
    <div>
      <h2>US Tax Estimate &amp; Optimization Plan</h2>
      <p class="muted">{{ tax_payment_plan.summary }}</p>
    </div>
    <mark class="{{ 'warning' if tax_payment_plan.confirmation_pending else 'confirmed' }}">3 actions</mark>
  </div>
  <div class="kpi-grid tax-file-kpis">
    <article class="kpi"><span>Estimated federal tax</span><strong>{{ tax_payment_plan.estimated_tax_before_display }}</strong><small>Draft estimate, not final tax due.</small></article>
    <article class="kpi"><span>Potential federal tax reduction</span><strong>{{ tax_payment_plan.samo_tax_savings_display }}</strong><small>State tax not included.</small></article>
    <article class="kpi"><span>After planning review</span><strong>{{ tax_payment_plan.optimized_tax_due_display }}</strong><small>Requires sale before year-end and CPA review.</small></article>
  </div>
  <div class="tax-split-grid">
    <article class="tax-split-card">
      <strong>Tax Reporting</strong>
      <span>Tax reporting explains what happened.</span>
      <table>
        <tbody>
          {% for row in tax_payment_plan.reporting_rows %}
          <tr><td>{{ row.label }}</td><td><strong>{{ row.value }}</strong><span class="muted">{{ row.note }}</span></td></tr>
          {% endfor %}
        </tbody>
      </table>
    </article>
    <article class="tax-split-card">
      <strong>Tax Planning</strong>
      <span>Tax planning identifies actions to review before year-end.</span>
      <table>
        <tbody>
          {% for row in tax_payment_plan.planning_rows %}
          <tr><td>{{ row.label }}</td><td><strong>{{ row.value }}</strong><span class="muted">{{ row.note }}</span></td></tr>
          {% endfor %}
        </tbody>
      </table>
    </article>
  </div>
  <div class="assumption-grid">
    {% for assumption in tax_payment_plan.assumptions %}
    <article class="assumption-card"><strong>Estimate assumptions</strong><span>{{ assumption }}</span></article>
    {% endfor %}
  </div>
  <div class="tax-breakdown-grid">
    <article class="tax-split-card">
      <strong>Estimated federal tax breakdown</strong>
      <table>
        <tbody>
          {% for row in tax_payment_plan.estimate_breakdown %}
          <tr><td>{{ row.label }}</td><td><strong>{{ row.value }}</strong></td></tr>
          {% endfor %}
        </tbody>
      </table>
    </article>
    <article class="tax-split-card">
      <strong>Potential federal tax reduction breakdown</strong>
      <table>
        <tbody>
          {% for row in tax_payment_plan.planning_breakdown %}
          <tr><td>{{ row.label }}</td><td><strong>{{ row.value }}</strong></td></tr>
          {% endfor %}
        </tbody>
      </table>
    </article>
  </div>
  <div class="tax-advice-grid">
    {% for card in tax_payment_plan.cards %}
    <article class="tax-advice-card {% if loop.index == 1 %}tax-advice-card-primary{% endif %}">
      <div class="tax-advice-topline">
        <span>{{ card.badge }}</span>
        <mark class="{{ card.status_class }}">{{ card.status_label }}</mark>
      </div>
      <h3>{{ card.title }}</h3>
      <p class="tax-impact">
        <span>{{ card.impact_label }}</span>
        <strong>{{ card.impact_display }}</strong>
      </p>
      <p><strong>Do this:</strong> {{ card.action }}</p>
      <p>{{ card.why }}</p>
    </article>
    {% endfor %}
  </div>
</section>
{% elif tax_advice or has_loss_playbook %}
<section class="report-section tax-playbook">
  <div class="section-heading">
    <div>
      <h2>Accountant Action Plan</h2>
      <p class="muted">Concrete review steps with an estimated tax effect before professional sign-off.</p>
    </div>
    <mark class="warning">{{ (tax_advice|length) + (1 if has_loss_playbook else 0) }} actions</mark>
  </div>
  <div class="tax-advice-grid">
    {% if has_loss_playbook %}
    <article class="tax-advice-card tax-advice-card-primary">
      <div class="tax-advice-topline">
        <span>Year-end planning</span>
        <mark class="{{ 'warning' if tax_loss_harvesting.available else 'neutral' }}">{{ tax_loss_harvesting.status_label }}</mark>
      </div>
      <h3>{{ tax_loss_harvesting.title }}</h3>
      <p class="tax-impact">
        <span>Potential tax impact</span>
        <strong>{{ tax_loss_harvesting.total_estimated_tax_effect_display }}</strong>
      </p>
      {% if tax_loss_harvesting.candidates %}
      <p><strong>Do this:</strong> Ask the accountant to review whether the listed lots should be sold, held, or documented for carryforward before year-end.</p>
      <ul>
        {% for candidate in tax_loss_harvesting.candidates %}
        {% if loop.index <= 3 %}
        <li>{{ candidate.amount }} {{ candidate.asset }}: {{ candidate.estimated_tax_effect_display }} from {{ candidate.unrealized_loss_display }} estimated loss.</li>
        {% endif %}
        {% endfor %}
      </ul>
      {% else %}
      <p><strong>Do this:</strong> Add verified current prices and acquisition lots so the app can detect year-end planning candidates.</p>
      {% endif %}
      <p class="muted">{{ tax_loss_harvesting.message }}</p>
      <p class="muted">
        Sources:
        {% for source in tax_loss_harvesting.sources %}
        <a href="{{ source.url }}" target="_blank" rel="noreferrer">{{ source.label }}</a>{% if not loop.last %}, {% endif %}
        {% endfor %}
      </p>
    </article>
    {% endif %}
    {% for advice in tax_advice %}
    <article class="tax-advice-card">
      <div class="tax-advice-topline">
        <span>{{ advice.badge }}</span>
        <mark class="{{ advice.status_class }}">{{ advice.impact_label }}</mark>
      </div>
      <h3>{{ advice.title }}</h3>
      <p class="tax-impact">
        <span>{{ advice.impact_label }}</span>
        <strong>{{ advice.estimated_tax_effect_display }}</strong>
      </p>
      <p><strong>Do this:</strong> {{ advice.action }}</p>
      <p>{{ advice.why }}</p>
      {% if advice.evidence %}
      <ul>
        {% for item in advice.evidence %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      <p class="muted">{{ advice.calculation }}</p>
      <p class="muted">Source: <a href="{{ advice.source_url }}" target="_blank" rel="noreferrer">{{ advice.source_label }}</a></p>
    </article>
    {% endfor %}
  </div>
  <p class="muted">Estimates use review SOL/fiat assumptions where exact FMV is missing. Replace with transaction-time fair market values before filing.</p>
</section>
{% endif %}

<section class="report-section tax-ack-scope" data-ack-scope="tax-deadlines">
  <details class="tax-deadlines-panel">
    <summary>
      <div>
        <h2>Tax Deadlines</h2>
        <p class="muted">Key filing and payment deadlines for {{ tax_country_profile.label }}. Completed items move to the end of the list and stay confirmed on this device.</p>
      </div>
      <mark class="medium"><span data-ack-count>{{ tax_deadlines|length }}</span> active</mark>
    </summary>
  <p class="muted">The dashboard warns when a deadline is within {{ tax_country_profile.deadline_warning_days }} days or already passed.</p>
  {% if tax_deadlines %}
  <div class="deadline-list">
    {% for deadline in tax_deadlines %}
    <article class="deadline-row {{ deadline.status }}" data-ack-item data-ack-kind="deadline" data-ack-id="{{ deadline.ack_id }}">
      <div>
        <strong>{{ deadline.label }}</strong>
        <span class="muted">{{ deadline.action }}</span>
        <span class="muted">{{ deadline.note }}</span>
      </div>
      <div>
        <mark data-ack-status class="{{ 'high' if deadline.status == 'overdue' else ('medium' if deadline.status == 'due-soon' else 'neutral') }}">{{ deadline.status_label }}</mark>
        <strong>{{ deadline.due_display }}</strong>
        <a href="{{ deadline.source_url }}" target="_blank" rel="noreferrer" class="muted">{{ deadline.source_label }}</a>
        <button type="button" class="ack-button" data-ack-button data-ack-id="{{ deadline.ack_id }}">{{ deadline.confirm_label }}</button>
      </div>
    </article>
    {% endfor %}
  </div>
  <p class="empty ack-empty" hidden>All deadline reminders are confirmed on this device.</p>
  {% else %}
  <p class="empty">No deadline profile is available for this country yet.</p>
  {% endif %}
  </details>
</section>

{% if unified_tax_assistant and tax_loss_harvesting and not has_tax_payment_plan %}
<section class="report-section">
  <div class="section-heading">
    <div>
      <h2>Potential Loss Harvesting Review</h2>
      <p class="muted">{{ tax_loss_harvesting.message }}</p>
    </div>
    <mark class="{{ 'warning' if tax_loss_harvesting.available else 'neutral' }}">{{ tax_loss_harvesting.status_label }}</mark>
  </div>
  <p>
    Potential unrealized loss: <strong>{{ tax_loss_harvesting.total_unrealized_loss_display }}</strong> •
    Potential tax impact before professional review: <strong>{{ tax_loss_harvesting.total_estimated_tax_effect_display }}</strong>
  </p>
  {% if tax_loss_harvesting.candidates %}
  <table>
    <thead><tr><th>Asset</th><th>Cost basis</th><th>Current value</th><th>Potential impact before review</th><th>Review note</th></tr></thead>
    <tbody>
      {% for candidate in tax_loss_harvesting.candidates %}
      <tr>
        <td><strong>{{ candidate.amount }} {{ candidate.asset }}</strong><span class="muted">{{ candidate.acquired_on }}</span></td>
        <td>{{ candidate.cost_basis_display }}</td>
        <td>{{ candidate.current_value_display }}<span class="muted">{{ candidate.market_price_display }} on {{ candidate.market_date }}</span></td>
        <td><strong>{{ candidate.estimated_tax_effect_display }}</strong></td>
        <td>{{ candidate.action }}<span class="muted">{{ candidate.warning }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>
{% endif %}

<section class="report-section">
  <h2>Tax Classification</h2>
  <p class="muted">This groups transactions by likely accounting/tax treatment based on parsed wallet activity.</p>
  <p class="muted">Review? means the group may need manual classification before you rely on it for tax/accounting totals.</p>
  {% if classification %}
  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Detected pattern</th>
        <th>Count</th>
        <th>SOL net</th>
        <th>Review?</th>
      </tr>
    </thead>
    <tbody>
      {% for r in classification %}
      <tr>
        <td><strong>{{ r.category_label }}</strong></td>
        <td><span class="muted">{{ r.case_labels | join(", ") }}</span></td>
        <td>{{ r.count }}</td>
        <td>{{ r.sol_net }}</td>
        <td>{% if r.flagged %}<mark class="medium">Review</mark>{% else %}<span class="muted">Usually no queue</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="empty">No transaction categories found.</p>
  {% endif %}
</section>

<section class="report-section">
  <h2>Review Queue</h2>
  {% if review_queue %}
  <div class="tx-list">
    <div class="tx-list-header tax-review-grid">
      <span>Date</span>
      <span>Category</span>
      <span>Change</span>
      <span>Status</span>
      <span>Review</span>
    </div>
    {% for item in review_queue %}
    <details class="tx-row">
      <summary class="tx-summary tax-review-grid">
        <span>{{ item.date }}</span>
        <span><mark class="neutral review-tier">{{ item.category_label }}</mark></span>
        <span>{{ item.sol_net }}</span>
        <span><mark class="{{ item.status }}">{{ item.status }}</mark></span>
        <span>{{ item.review_reason }}</span>
      </summary>
      <div class="tx-expanded">
        <h4>Why this needs review</h4>
        <p>{{ item.review_reason }}</p>
        <p class="muted">{{ item.short_explanation }}</p>
        {% if item.confidence_percent is not none and item.confidence_percent != '' %}
        <p><strong>AI confidence:</strong> {{ item.confidence_percent }}%</p>
        {% endif %}
        {% if item.evidence %}
        <h4>What we know</h4>
        <ul>{% for f in item.evidence %}<li>{{ f }}</li>{% endfor %}</ul>
        {% endif %}
        {% if item.missing_information %}
        <h4>What is missing</h4>
        <ul>{% for f in item.missing_information %}<li>{{ f }}</li>{% endfor %}</ul>
        {% endif %}
        <h4>Suggested next step</h4>
        <p>{{ item.suggested_tax_action }}</p>
        {% if item.transaction_warning %}
        <div class="tax-alert {{ item.transaction_warning.level }}" data-ack-item data-ack-id="{{ item.transaction_warning.ack_id }}">
          <strong>{{ item.transaction_warning.title }}</strong>
          <p>{{ item.transaction_warning.message }}</p>
          <button type="button" class="ack-button" data-ack-button data-ack-id="{{ item.transaction_warning.ack_id }}">Mark reviewed</button>
        </div>
        {% endif %}
        <h4>Likely {{ item.tax_country_label }} tax treatment</h4>
        <p>{{ item.tax_treatment }}</p>
        <p><strong>Possible tax:</strong> {{ item.tax_due }}</p>
        <p><strong>How to calculate:</strong> {{ item.tax_calculation }}</p>
        <p><strong>Forms to discuss:</strong> {{ item.tax_forms }}</p>
        <p><strong>Rate note:</strong> {{ item.tax_rate_note }}</p>
        {% if item.tax_deadline_notice %}
        <h4>Deadline reminder</h4>
        <div class="tax-alert {{ item.tax_deadline_notice.status }}" data-ack-item data-ack-id="{{ item.tax_deadline_notice.ack_id }}">
          <strong>{{ item.tax_deadline_notice.status_label }} · {{ item.tax_deadline_notice.due_display }}</strong>
          <p>{{ item.tax_deadline_notice.label }}. {{ item.tax_deadline_notice.action }}</p>
          <p>{{ item.tax_deadline_notice.note }}</p>
          <button type="button" class="ack-button" data-ack-button data-ack-id="{{ item.tax_deadline_notice.ack_id }}">{{ item.tax_deadline_notice.confirm_label }}</button>
        </div>
        {% endif %}
        <h4>Tax/accounting note</h4>
        <p>{{ item.tax_accounting_note }}</p>
        <div class="tx-technical"><code>Tier {{ item.tier }} · Rule {{ item.rule_id }} · Detected pattern: {{ item.detected_pattern }}</code></div>
        {% set raw_address = item.account_address if item.account_address else (address if not unified_tax_assistant else '') %}
        {% if raw_address and item.signature %}
        <p><a href="{{ url_for('tx_detail_route', address=raw_address, sig=item.signature) }}">View raw transaction</a></p>
        {% elif item.explorer_url %}
        <p><a href="{{ item.explorer_url }}" target="_blank" rel="noreferrer">View on Solana explorer</a></p>
        {% else %}
        <p class="muted">Raw transaction unavailable — missing wallet address or transaction hash</p>
        {% endif %}
      </div>
    </details>
    {% endfor %}
  </div>
  {% else %}
  <p class="empty">No transactions flagged for review.</p>
  {% endif %}
</section>

<section class="report-section">
  <h2>Yearly Summary</h2>
  {% if yearly %}
  {% if yearly_tax_file_summary|default(false) %}
  <table>
    <thead>
      <tr>
        <th>Year</th>
        <th>Realized Gain</th>
        <th>Ordinary Income</th>
        <th>Missing Basis</th>
        <th>Fees</th>
        <th>Estimated Federal Tax</th>
        <th>Taxable Events</th>
        <th>Review Items</th>
      </tr>
    </thead>
    <tbody>
      {% for r in yearly %}
      <tr>
        <td><strong>{{ r.year }}</strong></td>
        <td>{{ r.realized_gain_usd }}</td>
        <td>{{ r.ordinary_income_usd }}</td>
        <td>{{ r.missing_basis_usd }}</td>
        <td>{{ r.fees_usd }}</td>
        <td>{{ r.estimated_federal_tax_usd }}</td>
        <td>{{ r.taxable_count }}</td>
        <td>{{ r.review_items }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <table>
    <thead>
      <tr>
        <th>Year</th>
        <th>Income</th>
        <th>{% if unified_tax_assistant %}Outflows{% else %}Expense{% endif %}</th>
        <th>Fees</th>
        <th>Potentially taxable</th>
      </tr>
    </thead>
    <tbody>
      {% for r in yearly %}
      <tr>
        <td><strong>{{ r.year }}</strong></td>
        <td>{{ r.income_sol }}</td>
        <td>{{ r.expense_sol }}</td>
        <td>{{ r.fees_sol }}</td>
        <td>{{ r.taxable_count }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% else %}
  <p class="empty">No yearly data available.</p>
  {% endif %}
</section>

<section class="export-panel">
  <div>
    <p class="eyebrow">Export</p>
    {% if unified_tax_assistant %}
    <h2>CPA-ready package</h2>
    <p class="muted">This package is designed for taxpayer/CPA review. It does not file your tax return automatically. Draft Form 8949 fields, Schedule D summary inputs, review items, missing data, audit trail, and confidence scores stay traceable.</p>
    {% else %}
    <h2>Draft tax report</h2>
    <p class="muted">PDF is the primary handoff format. CSV and JSON remain available for accountants, reconciliation and developer workflows.</p>
    {% endif %}
  </div>
  <div class="export-actions">
    {% if unified_tax_assistant %}
    <a class="button primary export-primary" href="{{ url_for('tax_file_export_csv_route', tax_file_id=tax_file.id) }}">Download CPA-ready CSV</a>
    {% else %}
    <a class="button primary export-primary" href="{{ url_for('export_pdf_route', address=address) }}?tax_country={{ tax_country }}">Download PDF Report</a>
    {% endif %}
  </div>
  <div class="export-secondary">
    {% if unified_tax_assistant %}
    <a href="{{ url_for('tax_file_detail_route', tax_file_id=tax_file.id) }}">Back to Tax File Dashboard</a>
    <details class="action-details advanced-export-links">
      <summary class="link-button">Advanced / CPA workspace</summary>
      <a href="{{ url_for('tax_file_export_json_route', tax_file_id=tax_file.id) }}">Download CPA JSON package</a>
    </details>
    {% else %}
    <a href="{{ url_for('tax_export_csv_route', address=address) }}">Download Tax CSV</a>
    <a href="{{ url_for('tax_summary_csv_route', address=address) }}">Download Yearly Summary CSV</a>
    <a href="{{ url_for('tax_export_json_route', address=address) }}">Download accountant JSON</a>
    {% endif %}
  </div>
  {% if unified_tax_assistant %}
  <p class="final-value-line">From Solana wallet chaos to CPA-ready tax review in minutes.</p>
  {% endif %}
</section>

{% endif %}

<div class="tax-disclaimer tax-disclaimer-bottom">
  This is not financial or tax advice. Always consult a qualified tax professional.
</div>

{% endblock %}
